@inherits ScissorHands.Theme.IndexViewBase
@layout MainLayout

<section class="home">
    <header class="home hero">
        <p class="home eyebrow">Welcome to</p>
        <h1 class="home title">@Site!.Title</h1>
        @if (string.IsNullOrWhiteSpace(Site.Description) == false)
        {
            <p class="home subtitle">@Site.Description</p>
        }
    </header>
    <div class="home list">
        @if (Documents?.Any() == false)
        {
            <PostCard IsEmpty="true" />
        }
        else
        {
            @foreach (var post in Documents!)
            {
                <PostCard Post="@post"
                          ContentUrl="@GetContentUrl(post.Metadata.Slug)"
                          TagUrlFactory="@ContentUrlHelper.GetTagUrl"
                          MaxDescriptionLength="150" />
            }
        }
    </div>
</section>
