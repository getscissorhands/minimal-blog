@inherits ScissorHands.Theme.TagListViewBase
@layout MainLayout

<section class="tag-list-page">
    <header class="tag-page header">
        <h1 class="tag-page title">Tags</h1>
        <p class="tag-page description">Browse topics used across the published content.</p>
    </header>
    @if (TaggedDocuments?.Any() != true)
    {
        <p class="empty-state">No tags available.</p>
    }
    else
    {
        <ul class="tag-grid">
            @foreach (var tagEntry in TaggedDocuments.OrderBy(item => item.Key))
            {
                var count = tagEntry.Value.Posts.Count() + tagEntry.Value.Pages.Count();
                <li>
                    <a class="tag-card" href="@GetTagUrl(tagEntry.Key)">
                        <span>#@tagEntry.Key</span>
                        <small>@count @(count == 1 ? "item" : "items")</small>
                    </a>
                </li>
            }
        </ul>
    }
</section>
