@inherits ScissorHands.Theme.TagViewBase
@layout MainLayout

<section class="tag-page">
    <header class="tag-page header">
        <a class="tag-page back-link" href="@(LocaleContext?.TagIndexUrl ?? "tags")"><span aria-hidden="true">&larr;</span> All tags</a>
        <h1 class="tag-page title">#@Tag</h1>
    </header>
    @if (TaggedPosts?.Any() != true && TaggedPages?.Any() != true)
    {
        <p class="empty-state">No content available for this tag.</p>
    }
    else
    {
        @if (TaggedPosts?.Any() == true)
        {
            <section class="tag-section">
                <h2>Posts</h2>
                <ul class="tag-content-list">
                    @foreach (var post in TaggedPosts)
                    {
                        <li lang="@post.Metadata.Locale" @attributes="PublicationBadgeBase.GetRegionAttributes(post, PublicationBadgePlacement.Listing)">
                            <a href="@GetContentUrl(post.Metadata.Slug)">@post.Metadata.Title</a>
                            <PublicationBadges Content="@post" Placement="PublicationBadgePlacement.Listing" />
                            @if (post.Metadata.Published is { } published)
                            {
                                <time lang="@(LocaleContext?.Locale ?? "en-US")" datetime="@published.ToString("O", CultureInfo.InvariantCulture)">@published.ToString("MMMM dd, yyyy", CultureInfo.GetCultureInfo(LocaleContext?.Locale ?? "en-US"))</time>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        @if (TaggedPages?.Any() == true)
        {
            <section class="tag-section">
                <h2>Pages</h2>
                <ul class="tag-content-list">
                    @foreach (var pageDocument in TaggedPages)
                    {
                        <li lang="@pageDocument.Metadata.Locale" @attributes="PublicationBadgeBase.GetRegionAttributes(pageDocument, PublicationBadgePlacement.Listing)">
                            <a href="@GetContentUrl(pageDocument.Metadata.Slug)">@pageDocument.Metadata.Title</a>
                            <PublicationBadges Content="@pageDocument" Placement="PublicationBadgePlacement.Listing" />
                        </li>
                    }
                </ul>
            </section>
        }
    }
</section>
