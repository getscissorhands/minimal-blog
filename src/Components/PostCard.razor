@namespace ScissorHands.Theme.MinimalBlog.Components.PostCard

<article class="home card" lang="@Post.Metadata.Locale"
         @attributes="PublicationBadgeBase.GetRegionAttributes(Post, PublicationBadgePlacement.Listing)">
    @if (IsEmpty == true)
    {
        <div class="home card-content">
            <p class="home card-desc">No posts found.</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Post.Metadata.HeroImage))
        {
            <div class="home card-image">
                <a href="@ContentUrl"><img src="@ContentUrlHelper.GetImageUrl(Post.Metadata.HeroImage)" alt="@Post.Metadata.Title" loading="lazy" /></a>
            </div>
        }
        <div class="home card-content">
            <div class="home card-meta">
                @if (Post.Metadata.Published is { } published)
                {
                    <time lang="@(LocaleContext?.Locale ?? "en-US")" datetime="@published.ToString("O", CultureInfo.InvariantCulture)">@published.ToString("MMMM dd, yyyy", CultureInfo.GetCultureInfo(LocaleContext?.Locale ?? "en-US"))</time>
                }
            </div>
            <a class="home link" href="@ContentUrl">
                <h2 class="home card-title">@Post.Metadata.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Post.Metadata.Description))
                {
                    <p class="home card-desc">@GetTruncatedDescription()</p>
                }
            </a>
            <PublicationBadges Content="@Post" Placement="PublicationBadgePlacement.Listing" />
            @if (Post.Metadata.Tags.Any())
            {
                <ul class="home card-tags">
                    @foreach (var tag in Post.Metadata.Tags)
                    {
                        <li>
                            @if (TagUrlFactory is not null)
                            {
                                <a href="@TagUrlFactory(tag)">#@tag</a>
                            }
                            else
                            {
                                <span>#@tag</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</article>
