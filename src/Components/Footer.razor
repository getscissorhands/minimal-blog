@namespace ScissorHands.Theme.MinimalBlog.Components

<footer class="site-footer">
    <div class="site-footer inner">
        <div class="footer-links">
            @if (NavigationTree.FirstOrDefault(node => node.Path == "about"
                || node.Path.EndsWith("/about", StringComparison.Ordinal)) is { Url: not null } about)
            {
                <a href="@about.Url">@about.Title</a>
            }
        </div>
        <p>&copy; @DateTimeOffset.UtcNow.Year @Site!.Title &middot; inspired by <a href="https://github.com/alexanderhodes/astro-minimal-blog" target="_blank" rel="noopener noreferrer">astro-minimal-blog</a></p>
    </div>
</footer>
