@namespace ScissorHands.Theme.MinimalBlog.Components

<header class="site-header">
    <div class="site-header inner">
        <a href="@HomeUrl" class="site-title">
            <h1>@Site!.Title</h1>
        </a>
        <nav class="site-navigation" aria-label="Primary navigation">
            <ul class="navigation-list">
                <li><a href="@HomeUrl">Home</a></li>
                <NavigationItems Nodes="@NavigationTree" />
                @if (TagIndexUrl is not null)
                {
                    <li><a href="@TagIndexUrl">Tags</a></li>
                }
                <LanguageSwitcher />
                <li class="header-actions">
                    <button class="dark-mode-toggle" type="button" data-theme-toggle
                            aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
                        <span class="sun-icon" aria-hidden="true"></span>
                        <span class="moon-icon" aria-hidden="true"></span>
                    </button>
                    <a class="github-link" href="https://github.com/getscissorhands/minimal-blog" target="_blank" rel="noopener noreferrer"
                       aria-label="View Minimal Blog on GitHub" title="GitHub">
                        <span class="github-icon" aria-hidden="true"></span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>
