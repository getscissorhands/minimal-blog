@inherits ScissorHands.Theme.PostViewBase
@layout MainLayout

<LocalizationFallbackBanner />
<article class="post" lang="@LocaleContext?.ContentLocale"
         @attributes="PublicationBadgeBase.GetRegionAttributes(Document, PublicationBadgePlacement.Detail)">
    <PublicationBadges />
    @if (string.IsNullOrWhiteSpace(Document?.Metadata.HeroImage) == false)
    {
        <div class="post hero-image">
            <img src="@GetImageUrl(Document.Metadata.HeroImage)" alt="@Document.Metadata.Title" />
        </div>
    }
    <header class="post header">
        <p class="post meta">
            @if (Document?.Metadata.Published is { } published)
            {
                <time lang="@(LocaleContext?.Locale ?? "en-US")" datetime="@published.ToString("O", CultureInfo.InvariantCulture)">@published.ToString("MMMM dd, yyyy", CultureInfo.GetCultureInfo(LocaleContext?.Locale ?? "en-US"))</time>
            }
        </p>
        <h1 class="post title">@Document?.Metadata.Title</h1>
        <TagList Tags="@Document?.Metadata.Tags" CssClass="post tags" TagUrlFactory="@GetTagUrl" />
    </header>
    <div class="post body">
        @((MarkupString)Document?.Html!)
    </div>
</article>
