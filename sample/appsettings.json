{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Site": {
    "Title": "ScissorHands.NET - Minimal Blog",
    "Description": "A minimal, responsive blog for ScissorHands.NET, inspired by astro-minimal-blog.",
    "Locales": ["en-us", "ko-kr"],
    "Author": "ScissorHands Team",
    "Theme": "minimal-blog",
    "SiteUrl": "http://localhost:5000",
    "BaseUrl": "/",
    "HeroImage": "images/scissorhands-net.jpg",
    "TimeZone": "UTC",
    "UseDateInPostUrl": false,
    "Debug": false
  },

  "Theme": {
    "Localization": {
      "en-us": {
        "TranslationUnavailable": "This page is not available in English. Showing the original content.",
        "Draft": "Draft",
        "ScheduledOn": "Scheduled on {0}"
      },
      "ko-kr": {
        "TranslationUnavailable": "이 페이지는 한국어 번역이 없어 원문을 표시합니다.",
        "Draft": "초안",
        "ScheduledOn": "{0} 공개 예정"
      }
    }
  },

  "Plugins": [
    {
      "Id": "google-analytics",
      "Name": "Google Analytics",
      "Options": {
        "MeasurementId": "G-EXAMPLE"
      }
    },
    {
      "Id": "open-graph",
      "Name": "Open Graph",
      "Options": {
        "TwitterSiteId": "@getscissorhands"
      }
    }
  ]
}