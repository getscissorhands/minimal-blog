{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Site": {
    "Title": "ScissorHands.NET - Minimal Blog",
    "Description": "A minimal, responsive blog for ScissorHands.NET, inspired by astro-minimal-blog.",
    "Locale": "en-US",
    "Author": "ScissorHands Team",
    "Theme": "minimal-blog",
    "SiteUrl": "http://localhost:5000",
    "BaseUrl": "/",
    "HeroImage": "images/scissorhands-net.jpg",
    "UseLocaleInUrl": false,
    "UseDateInPostUrl": false,
    "Debug": false
  },

  "Plugins": [
    {
      "Id": "google-analytics",
      "Name": "Google Analytics",
      "Options": {
        "MeasurementId": "G-EXAMPLE"
      }
    },
    {
      "Id": "open-graph",
      "Name": "Open Graph",
      "Options": {
        "TwitterSiteId": "@getscissorhands"
      }
    }
  ]
}